#!/usr/bin/env python3
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from contract import ROOT, emit

REQUIRED = (
    "instruction-pack",
    "REVIEW-v2",
    "perimeter-phase1.graph-v2",
    "perimeter-phase1.registry-v2",
)


def main():
    started = time.perf_counter()
    path = os.path.join(ROOT, "docs", "lessons-read.json")
    cases = []
    try:
        data = json.load(open(path, encoding="utf-8"))
        items = {item.get("source"): item for item in data.get("read", [])}
    except Exception as exc:
        items = {}
        cases.append(("readable", False, str(exc)))
    for source in REQUIRED:
        item = items.get(source)
        if not item:
            cases.append((source, False, "missing from docs/lessons-read.json"))
            continue
        if source == "instruction-pack":
            commit = str(item.get("commit", ""))
            ok = commit.startswith("553a766")
            cases.append((source, ok, commit or "commit missing"))
        else:
            cases.append((source, True, "recorded"))
    return emit("lessons_read_ok", cases, 1, started)


if __name__ == "__main__":
    sys.exit(main())

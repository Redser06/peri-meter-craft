#!/usr/bin/env python3
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from contract import ROOT, emit


def main():
    started = time.perf_counter()
    path = os.path.join(ROOT, "projects", "perimeter", "perimeter-phase1.graph-v2.yaml")
    text = open(path, encoding="utf-8").read()
    checks = [
        ("workflow", "workflow: perimeter-phase1" in text),
        ("version", "version: 2" in text),
        ("branch", "branch: cursor/perimeter-rework-phase1" in text),
        ("base_sha", "base_sha: e98530a7fca251060890458559b68ac59a8a548f" in text),
        ("fail_closed", "on_cap_unknown: fail_closed" in text),
        ("spec_pin", "553a766fb16cbe995798bf9b066878deabf099b5" in text),
        ("track_count", "track_count: 11" in text),
        ("env_before_rotation", text.find("id: env_cleanup") < text.find("id: key_rotation_approval")),
    ]
    cases = [(name, ok, "present" if ok else "missing") for name, ok in checks]
    return emit("preflight_schema_valid", cases, 1, started)


if __name__ == "__main__":
    sys.exit(main())

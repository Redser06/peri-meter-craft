#!/usr/bin/env python3
import json
import os
import re
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from contract import ROOT, emit


def main():
    started = time.perf_counter()
    graph = open(os.path.join(ROOT, "projects", "perimeter", "perimeter-phase1.graph-v2.yaml"), encoding="utf-8").read()
    match = re.search(r"open_decisions:\s*\[([^\]]*)\]", graph)
    names = [part.strip() for part in (match.group(1) if match else "").split(",") if part.strip()]
    approval = json.load(open(os.path.join(ROOT, "approvals", "PERI-PHASE1-GRAPH-V2.json"), encoding="utf-8"))
    resolutions = approval.get("resolutions") or {}
    cases = []
    if not names:
        cases.append(("no_open_decisions", True, "none listed"))
    for name in names:
        text = str(resolutions.get(name, "")).strip()
        cases.append((name, bool(text), text or "unresolved"))
    return emit("preflight_no_open_approvals", cases, 1, started)


if __name__ == "__main__":
    sys.exit(main())

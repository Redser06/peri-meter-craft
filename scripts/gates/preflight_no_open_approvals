#!/usr/bin/env python3
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from contract import ROOT, emit


def main():
    started = time.perf_counter()
    approval_path = os.path.join(ROOT, "approvals", "PERI-PHASE1-GRAPH.json")
    exists = os.path.isfile(approval_path)
    cases = [
        ("graph_approval", exists, "recorded" if exists else "missing"),
    ]
    return emit("preflight_no_open_approvals", cases, 1, started)


if __name__ == "__main__":
    sys.exit(main())

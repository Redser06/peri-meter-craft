#!/usr/bin/env python3
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from contract import ROOT, emit

EXPECTED = "cursor/perimeter-rework-phase1"


def main():
    started = time.perf_counter()
    head = subprocess.check_output(["git", "-C", ROOT, "rev-parse", "--abbrev-ref", "HEAD"], text=True).strip()
    listed = subprocess.run(["git", "-C", ROOT, "show-ref", "--verify", "--quiet", f"refs/heads/{EXPECTED}"])
    cases = [
        ("current_branch", head == EXPECTED, head),
        ("branch_ref", listed.returncode == 0, "branch ref missing"),
    ]
    return emit("handoff_branch_exists", cases, 1, started)


if __name__ == "__main__":
    sys.exit(main())

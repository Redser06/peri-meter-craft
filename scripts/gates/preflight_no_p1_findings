#!/usr/bin/env python3
import json
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from contract import ROOT, emit


def main():
    started = time.perf_counter()
    package = json.load(open(os.path.join(ROOT, "package.json"), encoding="utf-8"))
    workflow = os.path.join(ROOT, ".github", "workflows", "ci.yml")
    workflow_text = open(workflow, encoding="utf-8").read() if os.path.isfile(workflow) else ""
    tracked = subprocess.run(["git", "-C", ROOT, "ls-files", ".env"], capture_output=True, text=True)
    fixture = json.load(open(os.path.join(ROOT, "tests", "fixtures", "ledger_cases.json"), encoding="utf-8"))
    names = {item["name"]: item for item in fixture}
    cases = [
        ("test_script", "vitest" in package.get("scripts", {}).get("test", ""), package.get("scripts", {}).get("test", "")),
        ("ci_cancel_guard", "if: ${{ !cancelled() }}" in workflow_text, "workflow missing the cancel guard"),
        ("env_untracked", tracked.stdout.strip() == "", tracked.stdout.strip() or "untracked"),
        (
            "ledger_fail_closed_cases",
            names.get("missing", {}).get("allowed") is False
            and names.get("unparseable", {}).get("allowed") is False
            and names.get("at_cap", {}).get("allowed") is False,
            "fixture must block missing, unparseable, and at-cap ledgers",
        ),
    ]
    return emit("preflight_no_p1_findings", cases, 1, started)


if __name__ == "__main__":
    sys.exit(main())
